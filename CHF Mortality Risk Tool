    "    \"anaemia\",\n",
    "    \"high_cpk\",\n",
    "    \"low_platelets\",\n",
    "    \"diabetes\",\n",
    "    \"high_blood_pressure\",\n",
    "    \"sex\",\n",
    "    \"smoking\"\n",
    "]\n",
    "\n",
    "high_risk_vars = [\"low_ef\", \"high_creatinine\", \"low_sodium\", \"age_70_plus\", \"anaemia\", \"high_blood_pressure\"]\n",
